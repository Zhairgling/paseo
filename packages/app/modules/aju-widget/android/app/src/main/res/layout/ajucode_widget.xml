<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/widget_bg"
  android:padding="12dp">

  <LinearLayout
    android:id="@+id/widget_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingBottom="8dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="AjuCode"
      android:textColor="#F2EDE6"
      android:textSize="13sp"
      android:textStyle="bold"/>

    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:background="@drawable/widget_pill_running"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:paddingTop="3dp"
      android:paddingBottom="3dp">

      <ImageView
        android:id="@+id/widget_running_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:src="@drawable/widget_dot_idle"
        android:contentDescription="@null"/>

      <TextView
        android:id="@+id/widget_running_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="Au repos"
        android:textColor="#F2EDE6"
        android:textSize="11sp"
        android:textStyle="bold"/>
    </LinearLayout>

    <TextView
      android:id="@+id/widget_waiting_badge"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:background="@drawable/widget_pill_waiting"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:paddingTop="3dp"
      android:paddingBottom="3dp"
      android:textColor="#E8A85A"
      android:textSize="11sp"
      android:textStyle="bold"
      android:visibility="gone"/>

    <TextView
      android:id="@+id/widget_updated_at"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="end"
      android:text=""
      android:textColor="#7A6F63"
      android:textSize="11sp"/>
  </LinearLayout>

  <TextView
    android:id="@+id/widget_empty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center"
    android:text="Aucune session active ou en attente.\nAppuie pour ouvrir AjuCode."
    android:textColor="#9B8D7B"
    android:textSize="12sp"/>

  <LinearLayout
    android:id="@+id/widget_row_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/widget_row_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/widget_dot_0"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/widget_dot_running"
        android:contentDescription="@null"/>
      <TextView
        android:id="@+id/widget_title_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F2EDE6"
        android:textSize="12sp"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/widget_age_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="#7A6F63"
        android:textSize="11sp"/>
    </LinearLayout>
    <TextView
      android:id="@+id/widget_subtitle_0"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="15dp"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#B5A898"
      android:textSize="11sp"/>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/widget_row_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/widget_row_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/widget_dot_1"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/widget_dot_running"
        android:contentDescription="@null"/>
      <TextView
        android:id="@+id/widget_title_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F2EDE6"
        android:textSize="12sp"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/widget_age_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="#7A6F63"
        android:textSize="11sp"/>
    </LinearLayout>
    <TextView
      android:id="@+id/widget_subtitle_1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="15dp"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#B5A898"
      android:textSize="11sp"/>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/widget_row_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/widget_row_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/widget_dot_2"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/widget_dot_running"
        android:contentDescription="@null"/>
      <TextView
        android:id="@+id/widget_title_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F2EDE6"
        android:textSize="12sp"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/widget_age_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="#7A6F63"
        android:textSize="11sp"/>
    </LinearLayout>
    <TextView
      android:id="@+id/widget_subtitle_2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="15dp"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#B5A898"
      android:textSize="11sp"/>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/widget_row_3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_row_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:visibility="gone">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/widget_dot_3"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/widget_dot_running"
        android:contentDescription="@null"/>
      <TextView
        android:id="@+id/widget_title_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F2EDE6"
        android:textSize="12sp"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/widget_age_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="#7A6F63"
        android:textSize="11sp"/>
    </LinearLayout>
    <TextView
      android:id="@+id/widget_subtitle_3"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="15dp"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#B5A898"
      android:textSize="11sp"/>
  </LinearLayout>
</LinearLayout>
